classDiagram
    %% ============================================
    %% PORTFOLIO SERVICE
    %% ============================================

    %% Controllers
    class PortfolioController {
        -aggregator: PortfolioAggregator
        -chartGenerator: ChartGenerator
        -repository: IPortfolioRepository
        +GetPortfolio(userID: UUID) PortfolioResponse
        +GetAssets(userID: UUID, filters: AssetFilters) UnifiedAssetResponse
        +GetTransactions(userID: UUID, filters: TransactionFilters) PaginatedTransactionResponse
        +GetPerformance(userID: UUID, period: string) PerformanceResponse
        +GetPnL(userID: UUID) PnLResponse
        +GetRiskMetrics(userID: UUID) RiskMetricsResponse
        +GetCharts(userID: UUID, period: string) ChartDataResponse
        +GetHistory(userID: UUID, from: Time, to: Time, interval: string) HistoryResponse
        +RefreshPortfolio(userID: UUID) PortfolioResponse
        +CreateManualAsset(userID: UUID, request: CreateManualAssetRequest) ManualAssetResponse
        +UpdateManualAsset(userID: UUID, assetID: UUID, request: UpdateManualAssetRequest) ManualAssetResponse
        +DeleteManualAsset(userID: UUID, assetID: UUID, confirm: bool) DeleteResponse
    }

    %% Core Logic
    class PortfolioAggregator {
        -brokerClient: BrokerServiceClient
        -pnlCalculator: PnLCalculator
        -riskAnalyzer: RiskAnalyzer
        -cacheManager: ICacheManager
        -notificationPublisher: NotificationPublisher
        -repository: IPortfolioRepository
        +AggregatePortfolio(userID: UUID, connections: List~BrokerConnection~) Portfolio
        +GetCurrentState(userID: UUID) Portfolio
        -fetchFromBroker(connection: BrokerConnection) ExchangePortfolio
        -fetchManualAssets(userID: UUID) List~ManualAsset~
        -fetchManualAssetPrices(assets: List~ManualAsset~) Map~string,float~
        -normalizeAssets(exchangePortfolios: List~ExchangePortfolio~, manualAssets: List~ManualAsset~) List~Asset~
        -calculateTotalValue(assets: List~Asset~) float
        -groupBySource(assets: List~Asset~) AssetBreakdown
    }

    class BrokerServiceClient {
        -httpClient: HTTPClient
        -baseURL: string
        -timeout: Duration
        +GetPortfolioData(broker: string, connectionID: UUID) PortfolioData
        +GetBatchPrices(symbols: List~string~) Map~string,PriceData~
        +GetHistoricalData(broker: string, symbol: string, interval: string, from: Time?, to: Time?) List~OHLCV~
        -buildRequest(endpoint: string, params: Map) HTTPRequest
        -handleResponse(response: HTTPResponse) Result
    }

    class PnLCalculator {
        -repository: IPortfolioRepository
        +CalculateRealized(transactions: List~Transaction~) float
        +CalculateUnrealized(assets: List~Asset~, currentPrices: Map~string,float~) float
        +CalculateTotalPnL(portfolio: Portfolio) PnLResult
        +CalculateManualAssetPnL(asset: ManualAsset, currentPrice: float) PnLResult
        -getCostBasis(asset: Asset, transactions: List~Transaction~) float
        -getAverageEntryPrice(transactions: List~Transaction~) float
    }

    class RiskAnalyzer {
        -repository: IPortfolioRepository
        +CalculateDrawdown(snapshots: List~PortfolioSnapshot~) DrawdownResult
        +CalculateVolatility(snapshots: List~PortfolioSnapshot~) float
        +CalculateSharpeRatio(snapshots: List~PortfolioSnapshot~, riskFreeRate: float) float
        +AnalyzeRisk(portfolio: Portfolio, snapshots: List~PortfolioSnapshot~) RiskMetrics
        -calculateReturns(snapshots: List~PortfolioSnapshot~) List~float~
        -findPeakValue(snapshots: List~PortfolioSnapshot~) float
    }

    class ChartGenerator {
        -repository: IPortfolioRepository
        +GenerateEquityCurve(userID: UUID, period: string) ChartData
        +GenerateAllocationChart(portfolio: Portfolio) ChartData
        +GeneratePerformanceChart(snapshots: List~PortfolioSnapshot~, period: string) ChartData
        -querySnapshots(userID: UUID, from: Time, to: Time) List~PortfolioSnapshot~
        -formatForFrontend(data: any) ChartData
    }

    class SnapshotScheduler {
        -aggregator: PortfolioAggregator
        -repository: IPortfolioRepository
        -ticker: Ticker
        +Start() void
        +Stop() void
        -createSnapshot(userID: UUID) error
        -createManualAssetValueHistory(userID: UUID) error
        -cleanupOldSnapshots() error
    }

    class TransactionSyncScheduler {
        -repository: IPortfolioRepository
        -sessionManager: SessionManager
        -brokerClient: BrokerServiceClient
        -syncInterval: Duration
        -sessionTimeout: Duration
        +Start() void
        +Stop() void
        +TriggerManualSync(userID: UUID, exchange: string?) SyncResult
        -syncForActiveUsers() void
        -getActiveUserSessions() List~UserSession~
        -syncUserTransactions(userID: UUID, connections: List~BrokerConnection~) SyncResult
        -normalizeTransactions(rawTxns: List~RawTransaction~) List~Transaction~
        -updateSyncLog(userID: UUID, result: SyncResult) void
    }

    class SessionManager {
        -repository: IPortfolioRepository
        -cacheManager: ICacheManager
        -sessionTimeout: Duration
        +CreateSession(userID: UUID, deviceType: string) UserSession
        +UpdateActivity(userID: UUID) void
        +EndSession(sessionID: UUID) void
        +GetActiveSessions() List~UserSession~
        +IsUserActive(userID: UUID) bool
        -cleanupInactiveSessions() void
    }

    class NotificationPublisher {
        -serviceBus: ServiceBusClient
        +PublishDrawdownAlert(userID: UUID, drawdown: float) error
        +PublishMilestoneReached(userID: UUID, milestone: string) error
        +PublishPortfolioValueChange(userID: UUID, changePercent: float, period: string) error
        +PublishPriceAlert(userID: UUID, alert: PriceAlert, currentPrice: float) error
        +PublishPortfolioRefresh(userID: UUID) error
        -buildMessage(event: Event) Message
    }

    %% Price Alerts
    class PriceAlertController {
        -alertManager: PriceAlertManager
        -repository: IPriceAlertRepository
        +CreateAlert(userID: UUID, request: CreatePriceAlertRequest) PriceAlertResponse
        +ListAlerts(userID: UUID, filters: PriceAlertFilters) PaginatedPriceAlertResponse
        +GetAlert(userID: UUID, alertID: UUID) PriceAlertDetailResponse
        +UpdateAlert(userID: UUID, alertID: UUID, request: UpdatePriceAlertRequest) PriceAlertResponse
        +PauseAlert(userID: UUID, alertID: UUID) PriceAlertResponse
        +ResumeAlert(userID: UUID, alertID: UUID) PriceAlertResponse
        +ResetAlert(userID: UUID, alertID: UUID) PriceAlertResponse
        +DeleteAlert(userID: UUID, alertID: UUID) DeleteResponse
    }

    class PriceAlertManager {
        -repository: IPriceAlertRepository
        -marketDataClient: MarketDataClient
        -notificationPublisher: NotificationPublisher
        -maxAlertsPerUser: int
        +CreateAlert(userID: UUID, request: CreatePriceAlertRequest) PriceAlert
        +UpdateAlert(userID: UUID, alertID: UUID, request: UpdatePriceAlertRequest) PriceAlert
        +GetAlertContext(alert: PriceAlert) AlertContext
        +ValidateAlertLimit(userID: UUID) error
        -enrichWithCurrentPrice(alerts: List~PriceAlert~) List~PriceAlertWithContext~
    }

    class PriceAlertScheduler {
        -repository: IPriceAlertRepository
        -marketDataClient: MarketDataClient
        -notificationPublisher: NotificationPublisher
        -checkInterval: Duration
        +Start() void
        +Stop() void
        +CheckAlerts() void
        -getActiveAlertsByAsset() Map~string,List~PriceAlert~~
        -checkCrossesAbove(alert: PriceAlert, currentPrice: float, previousPrice: float) bool
        -checkCrossesBelow(alert: PriceAlert, currentPrice: float, previousPrice: float) bool
        -checkChangePercent(alert: PriceAlert, currentPrice: float, comparisonPrice: float) bool
        -triggerAlert(alert: PriceAlert, currentPrice: float, comparisonPrice: float, changePercent: float) void
        -recordTriggerHistory(alert: PriceAlert, triggerDetails: TriggerDetails) void
        -checkCooldown(alert: PriceAlert) bool
        -expireAlerts() void
    }

    class IPriceAlertRepository {
        <<interface>>
        +Create(alert: PriceAlert) PriceAlert
        +FindByID(userID: UUID, alertID: UUID) PriceAlert
        +FindByUserID(userID: UUID, filters: PriceAlertFilters) List~PriceAlert~
        +FindActiveByAsset(asset: string) List~PriceAlert~
        +FindAllActive() List~PriceAlert~
        +Update(alert: PriceAlert) PriceAlert
        +Delete(userID: UUID, alertID: UUID) error
        +CountActive(userID: UUID) int
        +UpdateStatus(alertID: UUID, status: PriceAlertStatus) error
        +RecordTrigger(alertID: UUID, price: float) error
        +SaveHistory(history: PriceAlertHistory) error
        +GetHistory(alertID: UUID) List~PriceAlertHistory~
        +ExpireOldAlerts() int
    }

    class PriceAlertRepository {
        -db: Database
        +Create(alert: PriceAlert) PriceAlert
        +FindByID(userID: UUID, alertID: UUID) PriceAlert
        +FindByUserID(userID: UUID, filters: PriceAlertFilters) List~PriceAlert~
        +FindActiveByAsset(asset: string) List~PriceAlert~
        +FindAllActive() List~PriceAlert~
        +Update(alert: PriceAlert) PriceAlert
        +Delete(userID: UUID, alertID: UUID) error
        +CountActive(userID: UUID) int
        +UpdateStatus(alertID: UUID, status: PriceAlertStatus) error
        +RecordTrigger(alertID: UUID, price: float) error
        +SaveHistory(history: PriceAlertHistory) error
        +GetHistory(alertID: UUID) List~PriceAlertHistory~
        +ExpireOldAlerts() int
        -toPriceAlertModel(row: DatabaseRow) PriceAlert
    }

    class MarketDataClient {
        -httpClient: HTTPClient
        -baseURL: string
        +GetCurrentPrice(asset: string) PriceData
        +GetBatchPrices(assets: List~string~) Map~string,PriceData~
        +GetHistoricalPrice(asset: string, timestamp: Time) PriceData
        +GetPriceChange(asset: string, period: string) PriceChangeData
    }

    class PriceAlert {
        +ID: UUID
        +UserID: UUID
        +Asset: string
        +AlertType: PriceAlertType
        +TargetValue: float
        +ComparisonPeriod: string
        +Status: PriceAlertStatus
        +IsRecurring: bool
        +TriggeredCount: int
        +LastTriggeredAt: Time
        +LastTriggeredPrice: float
        +CooldownHours: int
        +NotifyEmail: bool
        +NotifyInApp: bool
        +NotifyPush: bool
        +ExpiresAt: Time
        +Notes: string
        +CreatedAt: Time
        +UpdatedAt: Time
    }

    class PriceAlertHistory {
        +ID: UUID
        +AlertID: UUID
        +UserID: UUID
        +TriggeredAt: Time
        +TriggerPrice: float
        +ComparisonPrice: float
        +ActualChangePercent: float
        +EmailSent: bool
        +InAppSent: bool
        +PushSent: bool
        +CreatedAt: Time
    }

    class CreatePriceAlertRequest {
        +Asset: string
        +AlertType: PriceAlertType
        +TargetValue: float
        +ComparisonPeriod: string
        +IsRecurring: bool
        +CooldownHours: int
        +NotifyEmail: bool
        +NotifyInApp: bool
        +NotifyPush: bool
        +ExpiresAt: Time
        +Notes: string
    }

    class UpdatePriceAlertRequest {
        +TargetValue: float
        +ComparisonPeriod: string
        +IsRecurring: bool
        +CooldownHours: int
        +NotifyEmail: bool
        +NotifyInApp: bool
        +NotifyPush: bool
        +ExpiresAt: Time
        +Notes: string
    }

    class PriceAlertFilters {
        +Asset: string
        +Status: PriceAlertStatus
        +AlertType: PriceAlertType
        +Page: int
        +PageSize: int
    }

    class AlertContext {
        +CurrentPrice: float
        +PercentToTarget: float
        +PriceDirection: string
    }

    class PriceChangeData {
        +Asset: string
        +CurrentPrice: float
        +ComparisonPrice: float
        +ChangeAmount: float
        +ChangePercent: float
        +Period: string
    }

    class TriggerDetails {
        +TriggerPrice: float
        +ComparisonPrice: float
        +ChangePercent: float
    }

    class PriceAlertType {
        <<enumeration>>
        CROSSES_ABOVE
        CROSSES_BELOW
        CHANGE_PERCENT
    }

    class PriceAlertStatus {
        <<enumeration>>
        ACTIVE
        TRIGGERED
        PAUSED
        EXPIRED
    }

    %% Portfolio Alert Preferences
    class AlertPreferencesController {
        -repository: IAlertPreferencesRepository
        +GetPreferences(userID: UUID) AlertPreferencesResponse
        +UpdatePreferences(userID: UUID, request: UpdateAlertPreferencesRequest) AlertPreferencesResponse
    }

    class IAlertPreferencesRepository {
        <<interface>>
        +GetByUserID(userID: UUID) PortfolioAlertPreferences
        +Upsert(preferences: PortfolioAlertPreferences) PortfolioAlertPreferences
        +UpdateLastAlertTime(userID: UUID, alertType: string) error
    }

    class PortfolioAlertPreferences {
        +UserID: UUID
        +EnableDrawdownAlerts: bool
        +DrawdownAlertThreshold: float
        +EnableValueChangeAlerts: bool
        +ValueChangeThresholdPercent: float
        +ValueChangePeriod: string
        +EnableValueAlerts: bool
        +ValueAlertThresholdUSD: float
        +EnableDailySummary: bool
        +DailySummaryTime: string
        +AlertViaEmail: bool
        +AlertViaInApp: bool
        +AlertViaPush: bool
        +AlertCooldownHours: int
        +LastDrawdownAlertAt: Time
        +LastValueChangeAlertAt: Time
        +LastValueAlertAt: Time
        +CreatedAt: Time
        +UpdatedAt: Time
    }

    class UpdateAlertPreferencesRequest {
        +DrawdownAlerts: DrawdownAlertConfig
        +ValueChangeAlerts: ValueChangeAlertConfig
        +ValueAlerts: ValueAlertConfig
        +DailySummary: DailySummaryConfig
        +AlertChannels: AlertChannelsConfig
        +CooldownHours: int
    }

    class DrawdownAlertConfig {
        +Enabled: bool
        +ThresholdPercent: float
    }

    class ValueChangeAlertConfig {
        +Enabled: bool
        +ThresholdPercent: float
        +Period: string
    }

    class ValueAlertConfig {
        +Enabled: bool
        +ThresholdUSD: float
    }

    class DailySummaryConfig {
        +Enabled: bool
        +Time: string
    }

    class AlertChannelsConfig {
        +Email: bool
        +InApp: bool
        +Push: bool
    }

    %% Repository
    class IPortfolioRepository {
        <<interface>>
        +SaveSnapshot(snapshot: PortfolioSnapshot) error
        +GetSnapshots(userID: UUID, from: Time, to: Time) List~PortfolioSnapshot~
        +GetLatestSnapshot(userID: UUID) PortfolioSnapshot
        +SaveTransaction(transaction: Transaction) error
        +GetTransactions(userID: UUID, filters: TransactionFilters) PaginatedResult~Transaction~
        +GetTransactionCount(userID: UUID, filters: TransactionFilters) int
        +CleanupOldSnapshots(before: Time) error
        +SaveAsset(asset: Asset) error
        +GetAssets(userID: UUID) List~Asset~
        +UpdateAsset(asset: Asset) error
        +DeleteAsset(assetID: UUID) error
        +CreateManualAsset(asset: ManualAsset) ManualAsset
        +GetManualAssets(userID: UUID, filters: ManualAssetFilters) List~ManualAsset~
        +GetManualAsset(userID: UUID, assetID: UUID) ManualAsset
        +UpdateManualAsset(asset: ManualAsset) ManualAsset
        +DeleteManualAsset(userID: UUID, assetID: UUID) error
        +CountManualAssets(userID: UUID) int
        +SaveManualAssetValueHistory(history: ManualAssetValueHistory) error
        +GetManualAssetValueHistory(assetID: UUID, from: Time, to: Time) List~ManualAssetValueHistory~
        +CreateSession(session: UserSession) UserSession
        +GetActiveSessions() List~UserSession~
        +UpdateSessionActivity(userID: UUID) error
        +EndSession(sessionID: UUID) error
        +GetSyncLog(userID: UUID) List~SyncLog~
        +CreateSyncLog(log: SyncLog) SyncLog
        +UpdateSyncLog(log: SyncLog) error
    }

    class PortfolioRepository {
        -db: Database
        +SaveSnapshot(snapshot: PortfolioSnapshot) error
        +GetSnapshots(userID: UUID, from: Time, to: Time) List~PortfolioSnapshot~
        +GetLatestSnapshot(userID: UUID) PortfolioSnapshot
        +SaveTransaction(transaction: Transaction) error
        +GetTransactions(userID: UUID, filters: TransactionFilters) PaginatedResult~Transaction~
        +GetTransactionCount(userID: UUID, filters: TransactionFilters) int
        +CleanupOldSnapshots(before: Time) error
        +SaveAsset(asset: Asset) error
        +GetAssets(userID: UUID) List~Asset~
        +UpdateAsset(asset: Asset) error
        +DeleteAsset(assetID: UUID) error
        +CreateManualAsset(asset: ManualAsset) ManualAsset
        +GetManualAssets(userID: UUID, filters: ManualAssetFilters) List~ManualAsset~
        +GetManualAsset(userID: UUID, assetID: UUID) ManualAsset
        +UpdateManualAsset(asset: ManualAsset) ManualAsset
        +DeleteManualAsset(userID: UUID, assetID: UUID) error
        +CountManualAssets(userID: UUID) int
        +SaveManualAssetValueHistory(history: ManualAssetValueHistory) error
        +GetManualAssetValueHistory(assetID: UUID, from: Time, to: Time) List~ManualAssetValueHistory~
        +CreateSession(session: UserSession) UserSession
        +GetActiveSessions() List~UserSession~
        +UpdateSessionActivity(userID: UUID) error
        +EndSession(sessionID: UUID) error
        +GetSyncLog(userID: UUID) List~SyncLog~
        +CreateSyncLog(log: SyncLog) SyncLog
        +UpdateSyncLog(log: SyncLog) error
        -toSnapshotModel(row: DatabaseRow) PortfolioSnapshot
        -fromSnapshotModel(snapshot: PortfolioSnapshot) DatabaseRow
        -toTransactionModel(row: DatabaseRow) Transaction
        -fromTransactionModel(transaction: Transaction) DatabaseRow
        -toManualAssetModel(row: DatabaseRow) ManualAsset
        -fromManualAssetModel(asset: ManualAsset) DatabaseRow
    }

    %% Cache Manager
    class ICacheManager {
        <<interface>>
        +Get(key: string) any
        +Set(key: string, value: any, ttl: Duration) error
        +Delete(key: string) error
        +DeletePattern(pattern: string) error
        +Exists(key: string) bool
        +Incr(key: string) int
    }

    class CacheManager {
        -redis: RedisClient
        +Get(key: string) any
        +Set(key: string, value: any, ttl: Duration) error
        +Delete(key: string) error
        +DeletePattern(pattern: string) error
        +Exists(key: string) bool
        +Incr(key: string) int
        -buildKey(prefix: string, identifier: string) string
        -serialize(data: any) string
        -deserialize(data: string) any
    }

