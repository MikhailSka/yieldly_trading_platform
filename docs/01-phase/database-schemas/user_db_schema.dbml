// Yieldly User Database Schema
// Database: user_db (PostgreSQL)

// Enums
Enum user_status {
  active
  suspended
  pending_verification
  deleted
}

Enum user_role {
  trader // Beta tester/free user
  admin  // Platform administrator
}

Enum trading_experience {
  beginner
  intermediate
  advanced
}

Enum theme_preference {
  light
  dark
  system
}

Enum language_preference {
  en // English
  pl // Polish
  ru // Russian
}

Enum auth_provider {
  email    // Email/password authentication
  google   // Google OAuth
}

Enum token_status {
  active
  used
  expired
}

// Core User Account Table
Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar(255) [not null, unique]
  email_verified boolean [default: false]
  password_hash varchar(255) [null, note: 'NULL for OAuth users']
  
  // Authentication
  auth_provider auth_provider [not null, default: 'email']
  auth_provider_id varchar(255) [null, note: 'ID from OAuth provider']
  
  // Status and Role
  status user_status [not null, default: 'pending_verification']
  role user_role [not null, default: 'trader']
  
  // Invite system
  invited_by_code varchar(50) [null]
  
  // Security
  last_login_at timestamp [null]
  last_login_ip inet [null]
  failed_login_attempts int [default: 0]
  locked_until timestamp [null]
  email_verified_at timestamp [null, note: 'Timestamp when email was verified']

  // Suspension tracking
  suspended_at timestamp [null, note: 'When account was suspended']
  suspended_by uuid [null, ref: > users.id, note: 'Admin who suspended the account']
  suspension_reason text [null, note: 'Reason for suspension']

  // Deletion scheduling
  deletion_scheduled_at timestamp [null, note: '30-day grace period before deletion']

  // Audit fields
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp [null, note: 'Soft delete for GDPR compliance']
  
  Indexes {
    email [unique]
    (auth_provider, auth_provider_id) [unique]
    status
    created_at
  }
}

// User Profile Information
Table user_profiles {
  user_id uuid [pk, ref: - users.id]
  
  // Basic information
  first_name varchar(100) [null]
  last_name varchar(100) [null]
  display_name varchar(100) [null]
  avatar_url varchar(500) [null, note: 'Azure Blob Storage URL']
  bio text [null]
  
  // Trading experience
  trading_experience trading_experience [default: 'beginner']
  
  // Audit fields
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  
  Indexes {
    display_name
  }
}

// User Preferences and Settings
Table user_preferences {
  user_id uuid [pk, ref: - users.id]
  
  // UI Preferences
  theme theme_preference [default: 'system']
  language language_preference [default: 'en']
  timezone varchar(50) [default: 'UTC']
  
  // Trading Preferences
  default_position_size decimal(20, 8) [null]
  preferred_margin_mode varchar(20) [null, note: 'margin or spot']
  preferred_trading_pairs jsonb [null, note: 'Array of preferred pairs']
  
  // Chart Preferences
  default_chart_timeframe varchar(10) [default: '1h']
  default_chart_type varchar(20) [default: 'candlestick']
  
  // Notification Preferences
  email_notifications_enabled boolean [default: true]
  in_app_notifications_enabled boolean [default: true]

  // Audit fields
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Indexes {
    language
    timezone
  }
}

// NOTE: Session management uses Redis cache (not database table)
// See: User Service - Cache Manager component (15-min TTL)
// Key format: session:{user_id}

// Invite Codes for Registration
Table invite_codes {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(50) [not null, unique]
  
  // Generation
  generated_by_user_id uuid [null, ref: > users.id, note: 'NULL if generated by admin']
  
  // Usage tracking
  max_uses int [not null, default: 1]
  current_uses int [not null, default: 0]
  
  // Validity
  valid_from timestamp [not null, default: `now()`]
  valid_until timestamp [null, note: 'NULL for no expiration']
  
  // Status
  is_active boolean [default: true]
  
  // Metadata
  notes text [null, note: 'Admin notes about this code']
  
  // Audit fields
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  
  Indexes {
    code [unique]
    is_active
    valid_until
    (is_active, valid_until)
  }
}

// Track which users were invited by which codes
Table invite_code_usage {
  id uuid [pk, default: `gen_random_uuid()`]
  invite_code_id uuid [not null, ref: > invite_codes.id]
  user_id uuid [not null, ref: > users.id]
  
  used_at timestamp [not null, default: `now()`]
  
  Indexes {
    invite_code_id
    user_id [unique]
  }
}

// Password Reset Tokens
Table password_reset_tokens {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  
  token_hash varchar(255) [not null, unique, note: 'Hashed token']
  status token_status [not null, default: 'active']
  
  // Expiration
  expires_at timestamp [not null]
  
  // Usage tracking
  used_at timestamp [null]
  
  // Audit fields
  created_at timestamp [not null, default: `now()`]
  
  Indexes {
    user_id
    token_hash [unique]
    (status, expires_at)
  }
}

// Email Verification Tokens
Table email_verification_tokens {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  
  token_hash varchar(255) [not null, unique, note: 'Hashed token']
  email varchar(255) [not null, note: 'Email being verified']
  status token_status [not null, default: 'active']
  
  // Expiration
  expires_at timestamp [not null]
  
  // Usage tracking
  used_at timestamp [null]
  
  // Audit fields
  created_at timestamp [not null, default: `now()`]
  
  Indexes {
    user_id
    token_hash [unique]
    (status, expires_at)
    email
  }
}

// User Activity Audit Log
Table user_activity_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  
  // Activity details
  activity_type varchar(100) [not null, note: 'login, logout, profile_update, etc.']
  activity_description text [null]
  
  // Request metadata
  ip_address inet [null]
  user_agent text [null]
  
  // Additional data
  metadata jsonb [null, note: 'Additional context']
  
  // Timestamp
  created_at timestamp [not null, default: `now()`]
  
  Indexes {
    user_id
    activity_type
    created_at
    (user_id, activity_type, created_at)
  }
}

// GDPR Data Export Requests
Table gdpr_exports {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  
  // Request status
  status varchar(50) [not null, default: 'pending', note: 'pending, processing, completed, failed']
  
  // Export details
  export_url varchar(500) [null, note: 'Azure Blob Storage URL for download']
  export_expires_at timestamp [null, note: 'Download link expiration']
  
  // Error handling
  error_message text [null]
  
  // Audit fields
  requested_at timestamp [not null, default: `now()`]
  completed_at timestamp [null]
  
  Indexes {
    user_id
    status
    requested_at
  }
}

// GDPR Account Deletion Log
Table gdpr_deletion_log {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  
  // Request status
  status varchar(50) [not null, default: 'pending', note: 'pending, approved, rejected, completed']
  
  // Reason and notes
  reason text [null, note: 'User provided reason']
  admin_notes text [null, note: 'Admin notes for review']
  
  // Processing
  reviewed_by_user_id uuid [null, ref: > users.id, note: 'Admin who reviewed']
  reviewed_at timestamp [null]
  
  // Completion
  scheduled_deletion_at timestamp [null, note: 'When actual deletion will occur']
  completed_at timestamp [null]
  
  // Audit fields
  requested_at timestamp [not null, default: `now()`]
  
  Indexes {
    user_id
    status
    requested_at
    scheduled_deletion_at
  }
}
