// Yieldly Backtesting Database Schema
// Database: backtest_db (PostgreSQL)

// Enums
Enum backtest_status {
  queued      // Waiting to be processed
  running     // Currently executing
  completed   // Successfully completed
  failed      // Failed with error
  cancelled   // User cancelled
}

Enum backtest_group_status {
  queued      // All backtests queued
  running     // At least one backtest running
  completed   // All backtests completed (may include failed)
  cancelled   // Group was cancelled
}

Enum trade_direction {
  long        // Buy/Long position
  short       // Sell/Short position
}

// Backtest Groups (Multi-Symbol Backtest Runs)
Table backtest_groups {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, note: 'Reference to users.id in user_db']
  strategy_id uuid [not null, note: 'Reference to strategies.id in strategy_db']

  // Strategy snapshot (shared across all backtests in group)
  strategy_code text [not null, note: 'Snapshot of strategy code when backtest was run']
  strategy_name varchar(255) [null, note: 'Strategy name at time of backtest']

  // Group configuration (shared parameters)
  timeframe varchar(10) [not null, note: '1m, 5m, 15m, 1h, 4h, 1d']
  start_date timestamptz [not null, note: 'Backtest start date']
  end_date timestamptz [not null, note: 'Backtest end date']
  initial_capital decimal(20, 8) [not null, note: 'Starting capital per symbol in USD']
  commission_rate decimal(10, 6) [not null, default: 0.001, note: 'Trading fee percentage']
  slippage_rate decimal(10, 6) [not null, default: 0.0005, note: 'Slippage percentage']

  // Symbols being tested (stored as array for reference)
  symbols varchar(500) [not null, note: 'Comma-separated list of symbols, e.g., BTCUSDT,ETHUSDT,SOLUSDT']
  symbol_count int [not null, note: 'Number of symbols in this group (1-10)']

  // Group status tracking
  status backtest_group_status [not null, default: 'queued']
  backtests_completed int [not null, default: 0, note: 'Number of individual backtests completed']
  backtests_failed int [not null, default: 0, note: 'Number of individual backtests failed']

  // Timing
  created_at timestamptz [not null, default: `now()`]
  started_at timestamptz [null, note: 'When first backtest started']
  completed_at timestamptz [null, note: 'When all backtests finished']

  // Metadata
  notes text [null, note: 'User notes about this backtest group']
  tags varchar(500) [null, note: 'Comma-separated tags for organization']

  // Soft delete / Archive
  archived_at timestamptz [null, note: 'When user archived this group (hidden from default list)']
  deleted_at timestamptz [null, note: 'Soft delete timestamp (not shown anywhere, kept for audit)']

  Indexes {
    user_id
    strategy_id
    status
    created_at
    (user_id, created_at)
    (user_id, strategy_id)
    (user_id, status)
    (user_id, archived_at)       // For filtering archived groups
    (user_id, deleted_at)        // For filtering deleted groups
  }

  Note: '''
  Groups multiple backtests running the same strategy on different symbols.
  Allows testing strategy robustness across multiple assets in parallel.
  Maximum 10 symbols per group.
  Each symbol gets its own backtest record for individual analysis.

  Soft Delete / Archive:
  - archived_at: User hides from default list, can restore. Still accessible via filter.
  - deleted_at: Soft delete, not shown anywhere. Kept for audit trail.
  - Archiving a group archives all its backtests automatically.
  - Deleted backtests still count toward quota (they were executed).
  '''
}

// Backtests (Main Table)
Table backtests {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, note: 'Reference to users.id in user_db']
  strategy_id uuid [not null, note: 'Reference to strategies.id in strategy_db']
  group_id uuid [null, ref: > backtest_groups.id, note: 'Reference to backtest group (null for standalone backtests)']

  // Strategy code snapshot (at time of backtest)
  strategy_code text [not null, note: 'Snapshot of strategy code when backtest was run']
  strategy_name varchar(255) [null, note: 'Strategy name at time of backtest']

  // Backtest configuration
  symbol varchar(50) [not null, note: 'Trading pair tested, e.g., BTCUSDT']
  timeframe varchar(10) [not null, note: '1m, 5m, 15m, 1h, 4h, 1d']
  start_date timestamptz [not null, note: 'Backtest start date']
  end_date timestamptz [not null, note: 'Backtest end date']

  // Capital and risk parameters
  initial_capital decimal(20, 8) [not null, note: 'Starting capital in USD']
  commission_rate decimal(10, 6) [not null, default: 0.001, note: 'Trading fee percentage (0.001 = 0.1%)']
  slippage_rate decimal(10, 6) [not null, default: 0.0005, note: 'Slippage percentage']

  // Execution status
  status backtest_status [not null, default: 'queued']

  // Timing
  created_at timestamptz [not null, default: `now()`]
  started_at timestamptz [null, note: 'When execution started']
  completed_at timestamptz [null, note: 'When execution finished']
  execution_duration_ms int [null, note: 'How long backtest took in milliseconds']

  // Error handling
  error_message text [null, note: 'Error details if status=failed']
  error_stacktrace text [null, note: 'Full stacktrace for debugging']

  // Metadata
  notes text [null, note: 'User notes about this backtest']
  tags varchar(500) [null, note: 'Comma-separated tags for organization']

  // Soft delete / Archive
  archived_at timestamptz [null, note: 'When user archived this backtest (hidden from default list)']
  deleted_at timestamptz [null, note: 'Soft delete timestamp (not shown anywhere, kept for audit)']

  Indexes {
    user_id
    strategy_id
    group_id                   // For fetching all backtests in a group
    status
    created_at
    (user_id, created_at)
    (user_id, strategy_id)
    (user_id, status)          // For filtering by status in list view
    (group_id, status)         // For tracking group progress
    (group_id, symbol)         // For fetching specific symbol in group
    symbol
    (symbol, timeframe)
    (user_id, symbol)          // For filtering by symbol in list view
    (strategy_name)            // For search functionality
    (user_id, archived_at)     // For filtering archived backtests
    (user_id, deleted_at)      // For filtering deleted backtests
    (group_id, archived_at)    // For checking if group backtests are archived
  }

  Note: '''
  Main backtest records. Each backtest is immutable once created.
  Strategy code is snapshotted to preserve exact version tested.
  Can be standalone (group_id = null) or part of a multi-symbol group.

  Soft Delete / Archive:
  - archived_at: User hides from default list, can restore. Still accessible via filter.
  - deleted_at: Soft delete, not shown anywhere. Kept for audit trail.
  - Individual backtests in a group can be archived separately.
  - Archived/deleted backtests still count toward quota (they were executed).
  '''
}

// Backtest Results (Performance Metrics)
Table backtest_results {
  id uuid [pk, default: `gen_random_uuid()`]
  backtest_id uuid [not null, unique, ref: - backtests.id, note: 'One result per backtest']
  
  // Capital metrics
  initial_capital decimal(20, 8) [not null]
  final_capital decimal(20, 8) [not null]
  net_profit decimal(20, 8) [not null, note: 'Final - Initial capital']
  
  // Return metrics
  total_return decimal(10, 4) [not null, note: 'Return percentage']
  annual_return decimal(10, 4) [null, note: 'Annualized return percentage']
  
  // Risk-adjusted metrics
  sharpe_ratio decimal(10, 4) [null, note: 'Risk-adjusted return metric']
  sortino_ratio decimal(10, 4) [null, note: 'Downside risk metric']
  calmar_ratio decimal(10, 4) [null, note: 'Return to max drawdown ratio']
  
  // Drawdown metrics
  max_drawdown decimal(10, 4) [not null, note: 'Maximum drawdown percentage']
  avg_drawdown decimal(10, 4) [null, note: 'Average drawdown percentage']
  max_drawdown_duration_hours int [null, note: 'Longest drawdown period in hours']
  
  // Trade statistics
  total_trades int [not null, default: 0]
  winning_trades int [not null, default: 0]
  losing_trades int [not null, default: 0]
  win_rate decimal(10, 4) [not null, note: 'Winning trades percentage']
  
  // Profit metrics
  profit_factor decimal(10, 4) [null, note: 'Gross profit / Gross loss']
  avg_win decimal(20, 8) [null, note: 'Average winning trade profit']
  avg_loss decimal(20, 8) [null, note: 'Average losing trade loss']
  largest_win decimal(20, 8) [null, note: 'Largest single winning trade']
  largest_loss decimal(20, 8) [null, note: 'Largest single losing trade']
  
  // Hold time metrics
  avg_trade_duration_hours decimal(10, 2) [null, note: 'Average time in position']
  max_trade_duration_hours decimal(10, 2) [null]
  min_trade_duration_hours decimal(10, 2) [null]
  
  // Exposure metrics
  market_exposure_percent decimal(10, 4) [null, note: 'Percentage of time in market']
  
  // Report files (Azure Blob Storage URLs)
  equity_curve_url varchar(500) [null, note: 'URL to equity curve chart']
  drawdown_curve_url varchar(500) [null, note: 'URL to drawdown curve chart']
  detailed_report_url varchar(500) [null, note: 'URL to full PDF/HTML report']
  
  // Metadata
  created_at timestamptz [not null, default: `now()`]
  
  Indexes {
    backtest_id [unique]
    total_return
    sharpe_ratio
    win_rate
    created_at
  }
  
  Note: '''
  Performance metrics and summary statistics for each backtest.
  One-to-one relationship with backtests table.
  Charts and detailed reports stored in Azure Blob Storage.
  '''
}

// Trades (Individual Trade Records)
Table trades {
  id uuid [pk, default: `gen_random_uuid()`]
  backtest_id uuid [not null, ref: > backtests.id]
  
  // Trade identification
  trade_number int [not null, note: 'Sequential trade number within backtest (1, 2, 3...)']
  
  // Position details
  direction trade_direction [not null]
  symbol varchar(50) [not null]
  
  // Entry
  entry_timestamp timestamptz [not null]
  entry_price decimal(20, 8) [not null]
  quantity decimal(30, 8) [not null]
  entry_value decimal(20, 8) [not null, note: 'entry_price * quantity']
  
  // Exit
  exit_timestamp timestamptz [not null]
  exit_price decimal(20, 8) [not null]
  exit_value decimal(20, 8) [not null, note: 'exit_price * quantity']
  
  // Performance
  pnl decimal(20, 8) [not null, note: 'Profit or loss in USD']
  pnl_percent decimal(10, 4) [not null, note: 'P&L as percentage of entry value']
  
  // Costs
  commission_paid decimal(20, 8) [not null, note: 'Total commission for entry + exit']
  slippage_cost decimal(20, 8) [not null, note: 'Estimated slippage cost']
  
  // Duration
  duration_hours decimal(10, 2) [not null, note: 'Time in position']
  
  // Exit reason (optional metadata)
  exit_reason varchar(100) [null, note: 'stop_loss, take_profit, signal, etc.']
  
  Indexes {
    backtest_id
    (backtest_id, trade_number) [unique]
    (backtest_id, entry_timestamp)  // For date filtering in trade list
    (backtest_id, direction)        // For direction filtering in trade list
    (backtest_id, pnl)              // For profitability filtering
    entry_timestamp
    direction
    pnl
  }
  
  Note: '''
  Individual trades executed during backtest.
  Used for:
  - Trade-by-trade analysis
  - Win/loss distribution charts
  - Trade log display
  
  Can have thousands of trades per backtest.
  '''
}

// Equity Curve Points (for charting)
Table equity_curve_points {
  id uuid [pk, default: `gen_random_uuid()`]
  backtest_id uuid [not null, ref: > backtests.id]
  
  // Time and value
  timestamp timestamptz [not null]
  portfolio_value decimal(20, 8) [not null, note: 'Total portfolio value at this point']
  
  // Optional: breakdown
  cash decimal(20, 8) [null, note: 'Cash balance']
  position_value decimal(20, 8) [null, note: 'Value of open position']
  
  // For performance
  point_number int [not null, note: 'Sequential point number for ordering']
  
  Indexes {
    backtest_id
    (backtest_id, timestamp)
    (backtest_id, point_number)
  }
  
  Note: '''
  Time-series data for equity curve visualization.
  Sampled during backtest execution (not every candle, but key points).
  Used to generate equity curve charts.
  '''
}

// Backtest Quota Tracking
Table backtest_quota {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, note: 'Reference to users.id in user_db']
  
  // Quota period
  period_start timestamptz [not null, note: 'Start of quota period (e.g., first day of month)']
  period_end timestamptz [not null, note: 'End of quota period']
  
  // Usage tracking
  backtests_run int [not null, default: 0]
  backtests_limit int [not null, note: 'Maximum allowed backtests for this period']
  
  // Metadata
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  
  Indexes {
    user_id
    (user_id, period_start, period_end) [unique]
    period_end
  }
  
  Note: '''
  Tracks user quota usage per period (e.g., monthly).
  Phase 1: All users have same limit (e.g., 100 backtests/month).
  Phase 2+: Different limits per subscription tier.
  '''
}

// Backtest Events Log (for auditing and debugging)
Table backtest_events {
  id uuid [pk, default: `gen_random_uuid()`]
  backtest_id uuid [not null, ref: > backtests.id]
  
  // Event details
  event_type varchar(100) [not null, note: 'queued, started, progress_update, completed, failed, cancelled']
  event_timestamp timestamptz [not null, default: `now()`]
  
  // Event data
  event_message text [null]
  event_data jsonb [null, note: 'Additional context like progress percentage, error details']
  
  Indexes {
    backtest_id
    event_timestamp
    (backtest_id, event_timestamp)
    (backtest_id, event_type)       // For fetching latest event of specific type
    event_type
  }
  
  Note: '''
  Audit trail of backtest lifecycle events.
  Retention: 90 days
  '''
}
