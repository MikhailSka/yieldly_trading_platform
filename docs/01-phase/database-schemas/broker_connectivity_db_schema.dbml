// Yieldly Broker Connectivity Database Schema
// Database: broker_db (PostgreSQL)

// Enums
Enum exchange_type {
  bybit
  binance
}

Enum connection_status {
  active       // Connection is working
  inactive     // User disabled
  error        // Connection has errors
  pending      // Awaiting verification
  suspended    // Admin suspended
}

Enum api_permission_type {
  read_only    // Only read permissions
  read_write   // Full permissions (not used in Phase 1)
}

Enum health_check_status {
  healthy
  degraded
  unhealthy
}

Enum rate_limit_type {
  per_second
  per_minute
  per_hour
  per_day
}

Enum sync_status {
  pending
  in_progress
  completed
  failed
  cancelled
}

Enum data_type {
  ohlcv        // Historical candlestick data
  trades       // Historical trades
  orderbook    // Order book snapshots
}

// Core Broker Connections Table
Table broker_connections {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, note: 'Reference to users.id in user_db']

  // Exchange information
  exchange exchange_type [not null]
  exchange_account_id varchar(255) [null, note: 'User account ID on exchange']

  // Connection details
  connection_name varchar(100) [null, note: 'User-friendly name for connection']
  status connection_status [not null, default: 'pending']

  // API credentials reference (actual keys in Azure Key Vault)
  key_vault_secret_name varchar(255) [not null, unique, note: 'Name of secret in Azure Key Vault']
  api_key_masked varchar(20) [not null, note: 'Masked API key for display (e.g., 5Lkj****Xb3B)']
  api_permission_type api_permission_type [not null, default: 'read_only']
  
  // Connection validation
  last_validated_at timestamp [null]
  validation_error text [null]
  
  // Health monitoring
  last_health_check_at timestamp [null]
  health_status health_check_status [default: 'healthy']
  consecutive_failures int [default: 0]
  
  // Rate limiting reference
  uses_custom_rate_limits boolean [default: false]
  
  // Detected API key capabilities (read-only, detected during validation)
  detected_capabilities jsonb [null, note: 'Auto-detected: {portfolio_read: true, market_data_read: true, trading: false, etc.}']
  capabilities_detected_at timestamp [null]
  
  // Usage statistics
  total_api_calls bigint [default: 0]
  last_api_call_at timestamp [null]
  
  // Audit fields
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp [null, note: 'Soft delete']
  
  Indexes {
    user_id
    exchange
    (user_id, exchange, deleted_at) [unique, note: 'One connection per exchange per user']
    status
    key_vault_secret_name [unique]
    health_status
    last_health_check_at
  }
}

// Exchange Configuration (system-wide settings per exchange)
Table exchange_configurations {
  id uuid [pk, default: `gen_random_uuid()`]
  exchange exchange_type [not null, unique]

  // API Endpoints
  rest_api_base_url varchar(255) [not null]
  websocket_base_url varchar(255) [null]

  // API Data Limits
  max_klines_per_request int [not null, default: 1000, note: 'Max candles per kline request']
  max_symbols_per_websocket int [not null, default: 50, note: 'Max symbols per WS connection']
  supported_intervals jsonb [not null, note: 'Array of supported kline intervals e.g., ["1m","5m","1h","1d"]']

  // Global rate limits (exchange defaults)
  rate_limit_requests_per_minute int [null, note: 'Requests per minute limit']
  rate_limit_orders_per_second int [null, note: 'Orders per second limit']
  rate_limit_weight_per_minute int [null, note: 'Request weight limit (for Binance-style)']

  // Timeout settings
  connection_timeout_ms int [not null, default: 5000]
  request_timeout_ms int [not null, default: 10000]
  websocket_ping_interval_ms int [not null, default: 30000]

  // Maintenance windows
  maintenance_windows jsonb [null, note: 'Scheduled maintenance windows [{dayOfWeek, startTimeUtc, durationMinutes}]']

  // Exchange-specific settings
  supports_websocket boolean [default: true]
  supports_testnet boolean [default: true]
  testnet_base_url varchar(255) [null]

  // API version
  api_version varchar(50) [not null]

  // Status
  is_active boolean [default: true]

  // Admin tracking
  updated_by_user_id uuid [null, note: 'Admin who last updated']

  // Audit fields
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Indexes {
    exchange [unique]
    is_active
  }
}

// Custom Rate Limits per Connection
Table connection_rate_limits {
  id uuid [pk, default: `gen_random_uuid()`]
  broker_connection_id uuid [not null, ref: > broker_connections.id]
  
  // Rate limit configuration
  limit_type rate_limit_type [not null]
  max_requests int [not null]
  
  // Current usage (tracked in Redis, but stored here for reference)
  current_usage int [default: 0]
  window_start_at timestamp [null]
  
  // Configuration
  is_active boolean [default: true]
  
  // Audit fields
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  
  Indexes {
    broker_connection_id
    (broker_connection_id, limit_type) [unique]
    is_active
  }
}

// API Call Logs (for monitoring and debugging)
Table api_call_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  broker_connection_id uuid [not null, ref: > broker_connections.id]
  
  // Request details
  endpoint varchar(500) [not null, note: 'API endpoint called']
  http_method varchar(10) [not null, note: 'GET, POST, etc.']
  
  // Response details
  response_status_code int [null]
  response_time_ms int [null, note: 'Response time in milliseconds']
  
  // Success/Failure
  is_successful boolean [not null]
  error_message text [null]
  error_code varchar(50) [null, note: 'Exchange-specific error code']
  
  // Rate limiting info
  rate_limit_remaining int [null]
  rate_limit_reset_at timestamp [null]
  
  // Request metadata
  request_id varchar(100) [null, note: 'Unique request ID for tracing']
  
  // Timestamp
  called_at timestamp [not null, default: `now()`]
  
  Indexes {
    broker_connection_id
    called_at
    (broker_connection_id, called_at)
    is_successful
    endpoint
  }
  
  Note: 'Retention: Keep logs for 30 days, then archive or delete'
}

// Connection Health Check History
Table connection_health_checks {
  id uuid [pk, default: `gen_random_uuid()`]
  broker_connection_id uuid [not null, ref: > broker_connections.id]
  
  // Health check results
  status health_check_status [not null]
  
  // Response time
  response_time_ms int [null]
  
  // Details
  check_details jsonb [null, note: 'Detailed health check results']
  error_message text [null]
  
  // Timestamp
  checked_at timestamp [not null, default: `now()`]
  
  Indexes {
    broker_connection_id
    checked_at
    (broker_connection_id, checked_at)
    status
  }
  
  Note: 'Retention: Keep checks for 90 days, then archive or delete'
}

// Exchange Market Information Cache
Table exchange_markets {
  id uuid [pk, default: `gen_random_uuid()`]
  exchange exchange_type [not null]

  // Market details
  symbol varchar(50) [not null, note: 'Trading pair symbol, e.g., BTCUSDT']
  base_currency varchar(20) [not null]
  quote_currency varchar(20) [not null]

  // Market status
  is_active boolean [default: true]
  is_trading boolean [default: true]

  // Market specifications
  min_order_size decimal(30, 15) [null]
  max_order_size decimal(30, 15) [null]
  price_precision int [null]
  quantity_precision int [null]

  // Fees
  maker_fee decimal(10, 6) [null]
  taker_fee decimal(10, 6) [null]

  // 24h Market Data (for trending/filtering)
  volume_24h_usd decimal(30, 2) [null, note: '24h trading volume in USD']
  price_change_24h_pct decimal(10, 4) [null, note: '24h price change percentage']
  last_price decimal(30, 15) [null, note: 'Last traded price']

  // Trending status
  is_trending boolean [default: false, note: 'Marked as trending based on volume/volatility']
  trending_reason varchar(50) [null, note: 'high_volume, high_volatility, volume_spike']

  // Additional metadata
  market_type varchar(50) [null, note: 'spot, futures, etc.']
  launch_time timestamp [null, note: 'When the market was launched']
  metadata jsonb [null, note: 'Exchange-specific market data']

  // Last sync
  last_synced_at timestamp [not null, default: `now()`]

  Indexes {
    exchange
    symbol
    (exchange, symbol) [unique]
    (base_currency, quote_currency)
    is_active
    is_trending
    volume_24h_usd
    last_synced_at
  }

  Note: 'Refreshed daily from exchange API. Volume/price data updated more frequently.'
}

// Historical Data Sync Jobs
Table data_sync_jobs {
  id uuid [pk, default: `gen_random_uuid()`]
  broker_connection_id uuid [not null, ref: > broker_connections.id]
  
  // Job configuration
  data_type data_type [not null]
  symbol varchar(50) [not null]
  timeframe varchar(10) [null, note: '1m, 5m, 1h, etc. - only for OHLCV']
  
  // Time range
  start_date timestamp [not null]
  end_date timestamp [not null]
  
  // Progress tracking
  status sync_status [not null, default: 'pending']
  progress_percentage decimal(5, 2) [default: 0]
  
  // Batch information
  total_batches int [null]
  completed_batches int [default: 0]
  
  // Records processed
  total_records_expected bigint [null]
  total_records_downloaded bigint [default: 0]
  total_records_inserted bigint [default: 0]
  
  // Error handling
  retry_count int [default: 0]
  max_retries int [default: 3]
  error_message text [null]
  
  // Performance metrics
  started_at timestamp [null]
  completed_at timestamp [null]
  duration_seconds int [null]
  
  // Timestamps
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  
  Indexes {
    broker_connection_id
    status
    (symbol, timeframe, start_date, end_date)
    created_at
  }
}

// Data Sync Job Details (granular batch tracking)
Table data_sync_job_batches {
  id uuid [pk, default: `gen_random_uuid()`]
  data_sync_job_id uuid [not null, ref: > data_sync_jobs.id]
  
  // Batch information
  batch_number int [not null]
  batch_start_date timestamp [not null]
  batch_end_date timestamp [not null]
  
  // Status
  status sync_status [not null, default: 'pending']
  
  // Records in this batch
  records_downloaded int [default: 0]
  records_inserted int [default: 0]
  
  // Error handling
  retry_count int [default: 0]
  error_message text [null]
  
  // Timing
  started_at timestamp [null]
  completed_at timestamp [null]
  
  Indexes {
    data_sync_job_id
    batch_number
    (data_sync_job_id, batch_number) [unique]
    status
  }
}

// Exchange API Status History (for monitoring exchange health)
Table exchange_status_history {
  id uuid [pk, default: `gen_random_uuid()`]
  exchange exchange_type [not null]
  
  // Status information
  is_operational boolean [not null]
  rest_api_available boolean [default: true]
  websocket_available boolean [default: true]
  
  // Performance metrics
  avg_response_time_ms int [null]
  
  // Issues
  known_issues text [null]
  
  // Timestamp
  checked_at timestamp [not null, default: `now()`]
  
  Indexes {
    exchange
    checked_at
    (exchange, checked_at)
    is_operational
  }
  
  Note: 'Retention: Keep status for 30 days'
}

// Connection Events (audit trail for connection changes)
Table connection_events {
  id uuid [pk, default: `gen_random_uuid()`]
  broker_connection_id uuid [not null, ref: > broker_connections.id]
  
  // Event details
  event_type varchar(100) [not null, note: 'created, activated, deactivated, credentials_rotated, etc.']
  event_description text [null]
  
  // Who triggered the event
  triggered_by_user_id uuid [null, note: 'NULL if system-triggered']
  
  // Additional context
  metadata jsonb [null]
  
  // IP and user agent (for security auditing)
  ip_address inet [null]
  user_agent text [null]
  
  // Timestamp
  occurred_at timestamp [not null, default: `now()`]
  
  Indexes {
    broker_connection_id
    event_type
    occurred_at
    (broker_connection_id, occurred_at)
    triggered_by_user_id
  }
}

// Webhook Configurations (for future use with exchange webhooks)
Table webhook_configurations {
  id uuid [pk, default: `gen_random_uuid()`]
  broker_connection_id uuid [not null, ref: > broker_connections.id]
  
  // Webhook details
  webhook_url varchar(500) [not null]
  webhook_secret varchar(255) [not null, note: 'For signature verification']
  
  // Events to subscribe to
  subscribed_events jsonb [not null, note: 'Array of event types']
  
  // Status
  is_active boolean [default: true]
  last_triggered_at timestamp [null]
  
  // Retry configuration
  max_retry_attempts int [default: 3]
  retry_backoff_seconds int [default: 60]
  
  // Audit fields
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  
  Indexes {
    broker_connection_id
    is_active
  }
  
  Note: 'Phase 1: Not implemented, prepared for future use'
}
